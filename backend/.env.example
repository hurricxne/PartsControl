# Plantilla del backend/.env — copiar a `.env` y completar con los valores reales.
# NUNCA commitear el .env real (está en .gitignore). Los valores de producción
# los entrega Aldo por canal directo.
#
# REGLA DURA (pydantic): `config.py` rechaza cualquier variable que NO esté declarada
# ahí (extra_forbidden) y entonces **el backend completo no arranca**. Al revés también
# importa: una variable que config.py declara y esta plantilla no menciona deja un
# entorno nuevo con la función apagada y sin ninguna pista de por qué. Si se agrega una
# variable a `config.py`, agregarla ACÁ en el mismo commit.

# Conexión MySQL (formato SQLAlchemy + PyMySQL)
DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@HOST:3306/NOMBRE_BD

# Firma de los JWT de login. Generar una PROPIA por entorno con:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# `config.py` hace fail-fast: con el valor de ESTA plantilla, con la clave vacía o sin la
# variable, la app NO arranca. Con menos de 32 caracteres arranca, pero avisa en el log.
SECRET_KEY=CAMBIAR-POR-UNO-ALEATORIO-LARGO

# --- Facturación electrónica (Wasabil → SII) --------------------------------------
# Los tokens se generan en https://app.wasabil.com/api-tokens y van SOLO acá.
# JAMÁS al repo, ni a un log, ni a un informe. Emitir al SII es IRREVERSIBLE.
# Sin token la app funciona igual, pero "Emitir guía/factura SII" queda bloqueado con
# un aviso (se puede previsualizar, no emitir).
#
# EL MISMO TOKEN ALIMENTA EL LIBRO DE COMPRAS DEL SII (módulos wasabil_compras/ y
# monza_wasabil_compras/): sin él, el barrido nocturno de las 05:30 se OMITE y la
# pantalla Contabilidad → Libro SII queda VACÍA para siempre, con el cartel "Nunca
# sincronizado". No es solo "no puedo emitir": es también "el libro no se llena".

# Cuenta GRUPO AM SPA — MachParts (módulo wasabil_dte/)
WASABIL_API_TOKEN=PEDIR-A-ALDO-POR-CANAL-DIRECTO

# Cuenta LOPEZ HERNANDEZ INVERSIONES SPA — MonzaParts, RUT 78.121.316-0
# (módulo monza_wasabil_dte/). Es una cuenta SEPARADA: el token de Grupo AM no sirve
# acá, y con este vacío MonzaParts no puede emitir al SII.
WASABIL_API_TOKEN_MONZA=PEDIR-A-ALDO-POR-CANAL-DIRECTO

# --- Feature flags: la única diferencia real entre PROD y QA ----------------------
# Contabilidad de MonzaParts. En PROD va en `false` (decisión del cliente 2026-07-15):
# con false, `main.py` ni importa esos 6 módulos → sus rutas responden 404 y `create_all`
# no crea sus 25 tablas (18 monza_cont_*/monza_tes_*/monza_emb_pricing* + 7 monza_sii_*
# del Libro de compras del SII, que desde 2026-08-08 también obedece a este flag).
# OJO: apagarlo NO exime de correr las migraciones marcadas
# 🔴 SIEMPRE en docs/CHECKLIST-DEPLOY-2026-07-20.md — hay tablas del núcleo Monza
# (monza_config, monza_cotizaciones, monza_despachos, monza_oc_proveedor) que se leen
# igual, con el flag apagado, desde routers que se montan siempre.
# Ausente = true.
MONZA_CONTAB_ENABLED=false

# --- Estreno del matcher banco↔libro SII ------------------------------------------
# ¿El matcher puede correr SOLO, sin nadie mirando, en el job de las 05:30?
# Ausente = false en las dos marcas, a propósito: el matcher no tiene ventana de fecha,
# así que la primera noche recorrería la cartola histórica COMPLETA y podría dejar
# movimientos del banco marcados como conciliados por una decisión automática que nadie
# revisó. Se estrena a mano (Contabilidad → Libro SII → "Correr matcher", de día y con
# el dueño del proceso al lado) y recién después se pone en true, una marca a la vez.
# El BARRIDO del libro corre igual con esto apagado: llenar el espejo del SII es lectura
# pura y es justo lo que hay que mirar en el estreno.
# SII_MATCHER_NOCTURNO=false
# SII_MATCHER_NOCTURNO_MONZA=false

# --- Verificación del folio en el registro manual de facturas/boletas (MonzaParts) ---
# Ausente = true. Con true, Contabilidad → Facturas → «Registrar ya emitida» verifica el
# folio contra Wasabil (mismo WASABIL_API_TOKEN_MONZA) o exige declararlo emitido fuera
# de Wasabil. Poner en false SOLO para correr suites antiguas sin Wasabil simulado, o como
# interruptor de emergencia si el API de consulta de Wasabil cambia.
# MONZA_FOLIO_VERIFICACION=true

# `Base.metadata.create_all()` al importar `main.py`: crea las tablas que falten, pero
# NO agrega columnas a tablas existentes (para eso están los scripts del checklist).
# Ausente = true. Ponerlo en false si se quiere un arranque que no toque el esquema.
AUTO_CREATE_TABLES=true

# --- Fase 0 del Portal de Clientes (2026-08-20) -----------------------------------
# Límite de intentos de login (backend/rate_limit_login.py). Ausente = true.
# Política, en ventanas de 15 min: 5 fallos por cuenta, 30 intentos por cuenta (éxitos
# incluidos) y 10 cuentas DISTINTAS con fallos por IP.
# Ponerlo en false solo si bloquea a alguien en un día de operación crítica; el
# contador también se limpia entero con `pm2 restart machparts-api`.
# Para ver el estado de una cuenta sin leer logs:
#     GET /api/auth/rate-limit/estado?email=...&ip=...
# LOGIN_RATE_LIMIT_ENABLED=true
#
# Servir uploads/bodega como carpeta PÚBLICA (comportamiento hasta 2026-08-20).
# Ausente = false. Las fotos ahora se sirven por GET /api/bodega/fotos/{id}, que
# exige sesión. Esta variable es la PALANCA DE ROLLBACK: ponerla en true y reiniciar
# devuelve el mount público en 30 segundos, sin desplegar código.
# SERVIR_FOTOS_BODEGA_SIN_AUTH=false

# --- Opcionales -------------------------------------------------------------------
# Orígenes permitidos por CORS. Ausente = localhost:5173 + machparts.bigcode.cl.
# ⚠️ EN PRODUCCIÓN, DESCOMENTARLO. El default incluye el origen de desarrollo
# http://localhost:5173, y con allow_credentials=True eso deja autorizado un origen
# que en el servidor no tiene por qué existir. El backend AVISA en el log de arranque
# ("[config] AVISO CORS: ...") mientras haya un origen de desarrollo autorizado.
# Se deja COMENTADO acá a propósito: quien copie esta plantilla para desarrollar
# perdería localhost:5173 y depuraría un error de CORS opaco.
# CORS_ORIGINS=["https://machparts.bigcode.cl"]
#
# Algoritmo de firma del JWT. Ausente = HS256. No cambiar: invalida las sesiones vivas.
# ALGORITHM=HS256
#
# Duración de la sesión, en minutos. Ausente = 480 (8 h, una jornada).
# ACCESS_TOKEN_EXPIRE_MINUTES=480
#
# Clave del webhook de Nexor (integración de leads). Vacía = webhook deshabilitado.
# NEXOR_WEBHOOK_KEY=
#
# Clave de la integración PartsFlow (creación de leads desde su WhatsApp IA). Vacía =
# integración deshabilitada. Una distinta por ambiente; se entrega al proveedor por un
# canal seguro. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# PARTSFLOW_API_KEY=
#
# Base del API de Wasabil. Ausente = https://api.wasabil.com/api. No tocar salvo que
# Wasabil cambie de dominio.
# WASABIL_API_BASE=https://api.wasabil.com/api
