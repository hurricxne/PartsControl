# Plantilla del backend/.env — copiar a `.env` y completar con los valores reales.
# NUNCA commitear el .env real (está en .gitignore). Los valores de producción
# los entrega Aldo por canal directo.

# Conexión MySQL (formato SQLAlchemy + PyMySQL)
DATABASE_URL=mysql+pymysql://USUARIO:CLAVE@HOST:3306/NOMBRE_BD

# Firma de los JWT de login (string largo aleatorio; en prod usar uno propio)
SECRET_KEY=CAMBIAR-POR-UNO-ALEATORIO-LARGO

# Token del facturador Wasabil (emisión de guías SII, cuenta GRUPO AM SPA).
# Sin este valor la app funciona igual, pero "Emitir guía SII" queda bloqueado.
WASABIL_API_TOKEN=PEDIR-A-ALDO-POR-CANAL-DIRECTO
